[Desktop Entry]
Type=Application
Name=distroClone USB
GenericName=Persistent Live USB Creator
GenericName[it]=Creatore USB live persistenti
GenericName[es]=Creador de USB live persistentes
GenericName[fr]=Créateur de clés USB live persistantes
GenericName[de]=Ersteller persistenter Live-USBs
Comment=Create a bootable USB with persistence from a live ISO
Comment[it]=Crea una USB avviabile con persistenza da una ISO live
Comment[es]=Crea un USB arrancable con persistencia a partir de una ISO live
Comment[fr]=Crée une clé USB amorçable avec persistance à partir d’une ISO live
Comment[de]=Erstellt einen startfähigen USB mit Persistenz aus einer Live-ISO
Exec=distroclone-usb
Icon=distroclone-usb
Terminal=false
Categories=System;
Keywords=USB;ISO;Live;Persistence;Debian;Ubuntu;
StartupNotify=true
StartupWMClass=distroclone-usb
