<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SysLinuxOS</vendor>
  <vendor_url>https://www.syslinuxos.com</vendor_url>
  <action id="com.syslinuxos.distroclone-usb.create">
    <description>Create a persistent live USB</description>
    <description xml:lang="it">Crea una USB live persistente</description>
    <description xml:lang="es">Crear un USB live persistente</description>
    <description xml:lang="fr">Créer une clé USB live persistante</description>
    <description xml:lang="de">Persistenten Live-USB erstellen</description>
    <message>Authentication is required to erase the selected USB and create a persistent live system.</message>
    <message xml:lang="it">Autenticazione richiesta per cancellare la USB selezionata e creare un sistema live persistente.</message>
    <message xml:lang="es">Se requiere autenticación para borrar el USB seleccionado y crear un sistema live persistente.</message>
    <message xml:lang="fr">Une authentification est requise pour effacer la clé USB sélectionnée et créer un système live persistant.</message>
    <message xml:lang="de">Zum Löschen des ausgewählten USB-Laufwerks und Erstellen eines persistenten Live-Systems ist eine Authentifizierung erforderlich.</message>
    <icon_name>distroclone-usb</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/distroclone-usb/helper.py</annotate>
  </action>
</policyconfig>
